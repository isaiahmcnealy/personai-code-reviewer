# Copy to .env and fill in. The CLI reads these from the environment.

# GitHub token used to fetch PR diffs. A fine-grained PAT with
# "Contents: Read" and "Pull requests: Read" on the target repos is enough.
GITHUB_TOKEN=

# Anthropic credentials. If you've run `ant auth login`, the SDK picks up the
# profile automatically and you can leave this unset.
ANTHROPIC_API_KEY=
